<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:BabyTracker.App.Localization"
             xmlns:vm="clr-namespace:BabyTracker.App.ViewModels"
             x:Class="BabyTracker.App.Views.AllTrackersPage"
             Title="{loc:Translate Key=AllTrackers_Title}">
    <CollectionView ItemsSource="{Binding Trackers}">
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="vm:TrackerListItem">
                <Grid Padding="15,14"
                        ColumnDefinitions="Auto,*">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectCommand}"
                            CommandParameter="{Binding .}"/>
                    </Grid.GestureRecognizers>
                    <Label Grid.Column="0"
                            Text="{Binding Icon}"
                            FontSize="24"
                            Margin="0,0,15,0"/>
                    <Label Grid.Column="1"
                            Text="{Binding Label}"
                            FontSize="16"
                            VerticalOptions="Center"/>
                </Grid>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>