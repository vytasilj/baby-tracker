<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:BabyTracker.App.Localization"
             x:Class="BabyTracker.App.Views.CalendarEntryPage"
             Title="{loc:Translate Key=Calendar_Title}">
    <ScrollView>
        <VerticalStackLayout Padding="20"
                Spacing="15">
            <Label Text="{loc:Translate Key=Calendar_EventTitleLabel}"/>
            <Entry Text="{Binding Title}"/>

            <Label Text="{loc:Translate Key=Calendar_ForLabel}"/>
            <Picker ItemsSource="{Binding ChildOptions}"
                    ItemDisplayBinding="{Binding Label}"
                    SelectedItem="{Binding SelectedChild}"/>

            <Label Text="{loc:Translate Key=Common_TimeLabel}"/>
            <HorizontalStackLayout Spacing="10">
                <DatePicker Date="{Binding EntryDate}"/>
                <TimePicker Time="{Binding EntryTime}"/>
            </HorizontalStackLayout>

            <Label Text="{loc:Translate Key=Common_NotesLabel}"/>
            <Entry Text="{Binding Notes}"/>

            <Button Text="{loc:Translate Key=Common_SaveButton}"
                    Command="{Binding SaveCommand}"/>
            <Button Text="{loc:Translate Key=Calendar_AddToDeviceCalendar}"
                    Command="{Binding AddToDeviceCalendarCommand}"/>
            <Button Text="{loc:Translate Key=Common_DeleteButton}"
                    Command="{Binding DeleteCommand}"
                    IsVisible="{Binding IsEditing}"
                    BackgroundColor="IndianRed"/>
            <ActivityIndicator IsRunning="{Binding IsSaving}"
                    IsVisible="{Binding IsSaving}"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>