<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:BabyTracker.App.Localization"
             x:Class="BabyTracker.App.Views.ChildSetupPage"
             Title="{loc:Translate Key=ChildSetup_Title}">
        <VerticalStackLayout Padding="20"
                             Spacing="15"
                             VerticalOptions="Center">
                <Label Text="{loc:Translate Key=ChildSetup_NameLabel}"/>
                <Entry Text="{Binding Name}"
                       Placeholder="{loc:Translate Key=ChildSetup_NamePlaceholder}"/>
                <Label Text="{loc:Translate Key=ChildSetup_BirthDateLabel}"/>
                <DatePicker Date="{Binding BirthDate}"
                            x:Name="BirthDatePicker"/>
                <Button Text="{loc:Translate Key=ChildSetup_SaveButton}"
                        Command="{Binding SaveCommand}"/>
                <ActivityIndicator IsRunning="{Binding IsSaving}"
                                   IsVisible="{Binding IsSaving}"/>
        </VerticalStackLayout>
</ContentPage>