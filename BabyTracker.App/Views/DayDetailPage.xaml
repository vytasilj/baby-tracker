<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:BabyTracker.App.Localization"
             xmlns:vm="clr-namespace:BabyTracker.App.ViewModels"
             x:Class="BabyTracker.App.Views.DayDetailPage"
             Title="{loc:Translate Key=DayDetail_Title}">
    <Grid RowDefinitions="Auto,*"
            Padding="15"
            RowSpacing="15">
        <HorizontalStackLayout Grid.Row="0"
                Spacing="10"
                HorizontalOptions="Center">
            <Button Text="◀"
                    Command="{Binding PreviousDayCommand}"
                    WidthRequest="46"/>
            <DatePicker Date="{Binding SelectedDate}"/>
            <Button Text="▶"
                    Command="{Binding NextDayCommand}"
                    WidthRequest="46"/>
        </HorizontalStackLayout>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="12"
                    BindableLayout.ItemsSource="{Binding Cards}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:HomeCardItem">
                        <Border Padding="15"
                                StrokeThickness="1"
                                Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14"/>
                            </Border.StrokeShape>
                            <Grid ColumnDefinitions="Auto,*">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenTrackerCommand}"
                                        CommandParameter="{Binding .}"/>
                                </Grid.GestureRecognizers>
                                <Label Grid.Column="0"
                                        Text="{Binding Icon}"
                                        FontSize="30"
                                        VerticalOptions="Center"/>
                                <VerticalStackLayout Grid.Column="1"
                                        Margin="15,0"
                                        VerticalOptions="Center">
                                    <Label Text="{Binding Label}"
                                            FontSize="14"
                                            Opacity="0.7"/>
                                    <Label Text="{Binding Summary}"
                                            FontSize="24"
                                            FontAttributes="Bold"/>
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>