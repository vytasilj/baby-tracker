<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:BabyTracker.App.Localization"
             xmlns:data="clr-namespace:BabyTracker.Data;assembly=BabyTracker.Data"
             x:Class="BabyTracker.App.Views.DiaperListPage"
             Title="{loc:Translate Key=Diaper_Title}">
    <Grid RowDefinitions="*,Auto">
        <CollectionView Grid.Row="0"
                        ItemsSource="{Binding Entries}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="data:DiaperEntry">
                    <Grid Padding="15,10"
                          ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="{Binding OccurredAt, StringFormat='{0:d.M. HH:mm}'}"
                                   FontAttributes="Bold"/>
                            <Label Text="{Binding Type}"
                                   FontSize="13"
                                   Opacity="0.7"/>
                        </VerticalStackLayout>
                        <Button Grid.Column="1"
                                Text="✏️"
                                BackgroundColor="Transparent"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EditEntryCommand}"
                                CommandParameter="{Binding .}"/>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <Button Grid.Row="1"
                Text="{loc:Translate Key=Common_AddNew}"
                Margin="15"
                Command="{Binding AddNewCommand}"/>
    </Grid>
</ContentPage>