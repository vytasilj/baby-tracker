<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BabyTracker.App.Views.HomePage"
             Title="Baby Tracker">
       <Grid RowDefinitions="Auto,*"
                     Padding="15">
              <HorizontalStackLayout Grid.Row="0"
                            HorizontalOptions="End"
                            Spacing="8">
                     <Button Text="⚙️"
                                   Command="{Binding OpenSettingsCommand}"
                                   WidthRequest="50"
                                   FontSize="20"/>
                     <Button Text="{Binding ThemeIcon}"
                                   Command="{Binding ToggleThemeCommand}"
                                   WidthRequest="50"
                                   FontSize="20"/>
              </HorizontalStackLayout>

              <VerticalStackLayout Grid.Row="1"
                            Spacing="10"
                            VerticalOptions="Center"
                            HorizontalOptions="Center">
                     <Label Text="{Binding ChildName}"
                                   FontSize="28"
                                   FontAttributes="Bold"
                                   HorizontalTextAlignment="Center"/>
                     <Label Text="{Binding Age}"
                                   FontSize="18"
                                   HorizontalTextAlignment="Center"/>
                     <Button Text="Diapers (temp)"
                                   Command="{Binding OpenDiapersCommand}"/>
                     <Button Text="Feeding (temp)"
                                   Command="{Binding OpenFeedingCommand}"/>
                     <Button Text="Sleep (temp)"
                                   Command="{Binding OpenSleepCommand}"/>
              </VerticalStackLayout>
       </Grid>
</ContentPage>