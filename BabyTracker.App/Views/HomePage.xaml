<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:BabyTracker.App.Localization"
             xmlns:vm="clr-namespace:BabyTracker.App.ViewModels"
             x:Class="BabyTracker.App.Views.HomePage"
             Title="Baby Tracker">
       <Grid RowDefinitions="Auto,Auto,*"
                     Padding="15"
                     RowSpacing="15">
              <HorizontalStackLayout Grid.Row="0"
                            HorizontalOptions="End"
                            Spacing="8">
                     <Button Text="📋"
                                   Command="{Binding OpenAllTrackersCommand}"
                                   WidthRequest="50"
                                   FontSize="20"/>
                     <Button Text="📊"
                                   Command="{Binding OpenStatisticsCommand}"
                                   WidthRequest="50"
                                   FontSize="20"/>
                     <Button Text="👶"
                                   Command="{Binding OpenChildrenCommand}"
                                   WidthRequest="50"
                                   FontSize="20"/>
                     <Button Text="⚙️"
                                   Command="{Binding OpenSettingsCommand}"
                                   WidthRequest="50"
                                   FontSize="20"/>
                     <Button Text="{Binding ThemeIcon}"
                                   Command="{Binding ToggleThemeCommand}"
                                   WidthRequest="50"
                                   FontSize="20"/>
              </HorizontalStackLayout>

              <VerticalStackLayout Grid.Row="1"
                            HorizontalOptions="Center"
                            Spacing="2">
                     <Label Text="{Binding ChildName}"
                                   FontSize="26"
                                   FontAttributes="Bold"
                                   HorizontalTextAlignment="Center"/>
                     <Label Text="{Binding Age}"
                                   FontSize="16"
                                   Opacity="0.7"
                                   HorizontalTextAlignment="Center"/>
              </VerticalStackLayout>

              <ScrollView Grid.Row="2">
                     <VerticalStackLayout Spacing="12"
                                   BindableLayout.ItemsSource="{Binding Cards}">
                            <BindableLayout.ItemTemplate>
                                   <DataTemplate x:DataType="vm:HomeCardItem">
                                          <Border Padding="15"
                                                        StrokeThickness="1"
                                                  Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}">
                                                 <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="14"/>
                                                 </Border.StrokeShape>
                                                 <Grid ColumnDefinitions="Auto,*,Auto">
                                                        <Grid.GestureRecognizers>
                                                               <TapGestureRecognizer
                                                                      Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenTrackerCommand}"
                                                                      CommandParameter="{Binding .}"/>
                                                        </Grid.GestureRecognizers>
                                                        <Label Grid.Column="0"
                                                                      Text="{Binding Icon}"
                                                                      FontSize="30"
                                                                      VerticalOptions="Center"/>
                                                        <VerticalStackLayout Grid.Column="1"
                                                                      Margin="15,0"
                                                                      VerticalOptions="Center">
                                                               <Label Text="{Binding Label}"
                                                                             FontSize="14"
                                                                             Opacity="0.7"/>
                                                               <Label Text="{Binding Summary}"
                                                                             FontSize="24"
                                                                             FontAttributes="Bold"/>
                                                        </VerticalStackLayout>
                                                        <Button Grid.Column="2"
                                                                      Text="+"
                                                                      FontSize="24"
                                                                      WidthRequest="46"
                                                                      HeightRequest="46"
                                                                CornerRadius="23"
                                                                      Padding="0"
                                                                      VerticalOptions="Center"
                                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.AddTrackerCommand}"
                                                                CommandParameter="{Binding .}"/>
                                                 </Grid>
                                          </Border>
                                   </DataTemplate>
                            </BindableLayout.ItemTemplate>
                     </VerticalStackLayout>
              </ScrollView>
       </Grid>
</ContentPage>