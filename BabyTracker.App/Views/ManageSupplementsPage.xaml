<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:BabyTracker.App.Localization"
             xmlns:vm="clr-namespace:BabyTracker.App.ViewModels"
             x:Class="BabyTracker.App.Views.ManageSupplementsPage"
             Title="{loc:Translate Key=ManageSupplements_Title}">
    <CollectionView ItemsSource="{Binding Items}">
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="vm:ManagedSupplementItem">
                <Grid Padding="15,12"
                        ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0"
                            Text="{Binding DisplayName}"
                            FontSize="16"
                            VerticalOptions="Center"/>
                    <Button Grid.Column="1"
                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ToggleHiddenCommand}"
                            CommandParameter="{Binding .}">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button"
                                    Binding="{Binding IsHidden}"
                                    Value="True">
                                <Setter Property="Text"
                                        Value="{loc:Translate Key=ManageSupplements_RestoreButton}"/>
                            </DataTrigger>
                            <DataTrigger TargetType="Button"
                                    Binding="{Binding IsHidden}"
                                    Value="False">
                                <Setter Property="Text"
                                        Value="{loc:Translate Key=ManageSupplements_HideButton}"/>
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </Grid>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>