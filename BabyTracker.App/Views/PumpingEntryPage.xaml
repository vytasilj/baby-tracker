<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:BabyTracker.App.Localization"
             x:Class="BabyTracker.App.Views.PumpingEntryPage"
             Title="{loc:Translate Key=Pumping_Title}">
    <VerticalStackLayout Padding="20"
            Spacing="15">
        <Label Text="{loc:Translate Key=Feeding_SideLabel}"/>
        <Picker ItemsSource="{Binding SideOptions}"
                ItemDisplayBinding="{Binding Display}"
                SelectedItem="{Binding SelectedSide}"/>

        <Label Text="{loc:Translate Key=Feeding_AmountLabel}"/>
        <Entry Text="{Binding AmountMl}"
                Keyboard="Numeric"/>

        <Label Text="{loc:Translate Key=Common_TimeLabel}"/>
        <HorizontalStackLayout Spacing="10">
            <DatePicker Date="{Binding EntryDate}"/>
            <TimePicker Time="{Binding EntryTime}"/>
        </HorizontalStackLayout>

        <Label Text="{loc:Translate Key=Common_NotesLabel}"/>
        <Entry Text="{Binding Notes}"/>

        <Button Text="{loc:Translate Key=Common_SaveButton}"
                Command="{Binding SaveCommand}"/>
        <Button Text="{loc:Translate Key=Common_DeleteButton}"
                Command="{Binding DeleteCommand}"
                IsVisible="{Binding IsEditing}"
                BackgroundColor="IndianRed"/>
        <ActivityIndicator IsRunning="{Binding IsSaving}"
                IsVisible="{Binding IsSaving}"/>
    </VerticalStackLayout>
</ContentPage>