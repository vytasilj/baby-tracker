<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:BabyTracker.App.Localization"
             x:Class="BabyTracker.App.Views.SettingsPage"
             Title="{loc:Translate Key=Settings_Title}">
    <VerticalStackLayout Padding="20"
                         Spacing="15">
        <Label Text="{loc:Translate Key=Settings_LanguageLabel}"/>
        <Picker ItemsSource="{Binding Languages}"
                ItemDisplayBinding="{Binding DisplayName}"
                SelectedItem="{Binding SelectedLanguage}"/>

        <Label Text="{loc:Translate Key=Settings_UnitsLabel}"/>
        <Picker ItemsSource="{Binding UnitSystems}"
                ItemDisplayBinding="{Binding Display}"
                SelectedItem="{Binding SelectedUnitSystem}"/>
        <Button Text="{loc:Translate Key=ManageSupplements_Title}"
                Command="{Binding OpenManageSupplementsCommand}"/>
        </VerticalStackLayout>
</ContentPage>