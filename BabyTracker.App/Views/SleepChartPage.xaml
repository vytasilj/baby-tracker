<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:BabyTracker.App.Localization"
             xmlns:microcharts="clr-namespace:Microcharts.Maui;assembly=Microcharts.Maui"
             x:Class="BabyTracker.App.Views.SleepChartPage"
             Title="{loc:Translate Key=Statistics_SleepChart}">
    <ScrollView>
        <VerticalStackLayout Padding="15"
                Spacing="20">
            <Label Text="{loc:Translate Key=Sleep_Title}"
                    FontAttributes="Bold"
                    FontSize="18"/>
            <microcharts:ChartView Chart="{Binding BabyChart}"
                    HeightRequest="220"/>

            <Label Text="{loc:Translate Key=MomSleep_Title}"
                    FontAttributes="Bold"
                    FontSize="18"/>
            <microcharts:ChartView Chart="{Binding MomChart}"
                    HeightRequest="220"/>

            <Label Text="{loc:Translate Key=Statistics_NoData}"
                    IsVisible="{Binding NoData}"
                    HorizontalTextAlignment="Center"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>