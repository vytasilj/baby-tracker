<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:BabyTracker.App.Localization"
             x:Class="BabyTracker.App.Views.SleepEntryPage"
             Title="{loc:Translate Key=Sleep_Title}">
    <ScrollView>
        <VerticalStackLayout Padding="20"
                Spacing="15">
            <Label Text="{loc:Translate Key=Sleep_StartLabel}"/>
            <HorizontalStackLayout Spacing="10">
                <DatePicker Date="{Binding StartDate}"/>
                <TimePicker Time="{Binding StartTime}"/>
                <Button Text="{loc:Translate Key=Common_NowButton}"
                        Command="{Binding SetStartNowCommand}"/>
            </HorizontalStackLayout>

            <HorizontalStackLayout Spacing="10">
                <Label Text="{loc:Translate Key=Sleep_HasEndedLabel}"
                        VerticalOptions="Center"/>
                <Switch IsToggled="{Binding HasEnded}"/>
            </HorizontalStackLayout>

            <VerticalStackLayout IsVisible="{Binding HasEnded}"
                    Spacing="15">
                <Label Text="{loc:Translate Key=Sleep_EndLabel}"/>
                <HorizontalStackLayout Spacing="10">
                    <DatePicker Date="{Binding EndDate}"/>
                    <TimePicker Time="{Binding EndTime}"/>
                    <Button Text="{loc:Translate Key=Common_NowButton}"
                            Command="{Binding SetEndNowCommand}"/>
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <Label Text="{loc:Translate Key=Common_NotesLabel}"/>
            <Entry Text="{Binding Notes}"/>

            <Label Text="{Binding ErrorMessage}"
                    TextColor="IndianRed"
                    IsVisible="{Binding HasError}"/>

            <Button Text="{loc:Translate Key=Common_SaveButton}"
                    Command="{Binding SaveCommand}"/>
            <Button Text="{loc:Translate Key=Common_DeleteButton}"
                    Command="{Binding DeleteCommand}"
                    IsVisible="{Binding IsEditing}"
                    BackgroundColor="IndianRed"/>
            <ActivityIndicator IsRunning="{Binding IsSaving}"
                    IsVisible="{Binding IsSaving}"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>