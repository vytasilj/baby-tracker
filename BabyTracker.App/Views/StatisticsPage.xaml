<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:BabyTracker.App.Localization"
             x:Class="BabyTracker.App.Views.StatisticsPage"
             Title="{loc:Translate Key=Statistics_Title}">
    <VerticalStackLayout Padding="15"
            Spacing="10">
        <Button Text="{loc:Translate Key=DayDetail_Title}"
                Command="{Binding OpenDayDetailCommand}"/>
        <Button Text="{loc:Translate Key=Statistics_WeightChart}"
                Command="{Binding OpenWeightChartCommand}"/>
        <Button Text="{loc:Translate Key=Statistics_SleepChart}"
                Command="{Binding OpenSleepChartCommand}"/>
        </VerticalStackLayout>
</ContentPage>