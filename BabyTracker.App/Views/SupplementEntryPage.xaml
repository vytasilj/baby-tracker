<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:BabyTracker.App.Localization"
             xmlns:vm="clr-namespace:BabyTracker.App.ViewModels"
             x:Class="BabyTracker.App.Views.SupplementEntryPage"
             Title="{loc:Translate Key=Supplement_Title}">
    <ScrollView>
        <VerticalStackLayout Padding="20"
                Spacing="15">
            <Label Text="{loc:Translate Key=Supplement_PickLabel}"/>

            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Supplements}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:SelectableSupplement">
                        <Grid Padding="0,6"
                                ColumnDefinitions="Auto,*,Auto">
                            <CheckBox Grid.Column="0"
                                    IsChecked="{Binding IsSelected}"/>
                            <Label Grid.Column="1"
                                    Text="{Binding DisplayName}"
                                    VerticalOptions="Center"/>
                            <Button Grid.Column="2"
                                     Text="🗑️"
                                     BackgroundColor="Transparent"
                                     FontSize="16"
                                     Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=HideRequestCommand}"
                                     CommandParameter="{Binding .}"/>
                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <HorizontalStackLayout Spacing="8">
                <Entry Text="{Binding NewCustomName}"
                        Placeholder="{loc:Translate Key=Supplement_NewCustomPlaceholder}"
                        WidthRequest="200"/>
                <Button Text="{loc:Translate Key=Common_AddNew}"
                        Command="{Binding AddCustomCommand}"/>
            </HorizontalStackLayout>

            <Label Text="{loc:Translate Key=Common_TimeLabel}"/>
            <HorizontalStackLayout Spacing="10">
                <DatePicker Date="{Binding EntryDate}"/>
                <TimePicker Time="{Binding EntryTime}"/>
            </HorizontalStackLayout>

            <Label Text="{loc:Translate Key=Common_NotesLabel}"/>
            <Entry Text="{Binding Notes}"/>

            <Button Text="{loc:Translate Key=Common_SaveButton}"
                    Command="{Binding SaveCommand}"/>
            <Button Text="{loc:Translate Key=Common_DeleteButton}"
                    Command="{Binding DeleteCommand}"
                    IsVisible="{Binding IsEditing}"
                    BackgroundColor="IndianRed"/>
            <ActivityIndicator IsRunning="{Binding IsSaving}"
                    IsVisible="{Binding IsSaving}"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>