<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:BabyTracker.App.Localization"
             xmlns:vm="clr-namespace:BabyTracker.App.ViewModels"
             x:Class="BabyTracker.App.Views.VaccinationEntryPage"
             Title="{loc:Translate Key=Vaccination_Title}">
    <ScrollView>
        <VerticalStackLayout Padding="20"
                Spacing="15">
            <Label Text="{loc:Translate Key=Vaccination_PickLabel}"/>
            <Picker ItemsSource="{Binding VaccineOptions}"
                    ItemDisplayBinding="{Binding DisplayName}"
                    SelectedItem="{Binding SelectedVaccine}"/>

            <HorizontalStackLayout Spacing="8">
                <Entry Text="{Binding NewCustomName}"
                        Placeholder="{loc:Translate Key=Supplement_NewCustomPlaceholder}"
                        WidthRequest="200"/>
                <Button Text="{loc:Translate Key=Common_AddNew}"
                        Command="{Binding AddCustomCommand}"/>
            </HorizontalStackLayout>

            <HorizontalStackLayout Spacing="10">
                <Label Text="{loc:Translate Key=Vaccination_AlreadyGivenLabel}"
                        VerticalOptions="Center"/>
                <Switch IsToggled="{Binding IsGiven}"/>
            </HorizontalStackLayout>

            <Label Text="{Binding DateLabel}"/>
            <DatePicker Date="{Binding EntryDate}"/>

            <Label Text="{loc:Translate Key=Vaccination_DoseLabel}"/>
            <Entry Text="{Binding DoseNumber}"
                    Keyboard="Numeric"/>

            <Label Text="{loc:Translate Key=Common_NotesLabel}"/>
            <Entry Text="{Binding Notes}"/>

            <Button Text="{loc:Translate Key=Common_SaveButton}"
                    Command="{Binding SaveCommand}"/>
            <Button Text="{loc:Translate Key=Calendar_AddToDeviceCalendar}"
                    Command="{Binding AddToDeviceCalendarCommand}"
                    IsVisible="{Binding ShowAddToCalendar}"/>
            <Button Text="{loc:Translate Key=Common_DeleteButton}"
                    Command="{Binding DeleteCommand}"
                    IsVisible="{Binding IsEditing}"
                    BackgroundColor="IndianRed"/>
            <ActivityIndicator IsRunning="{Binding IsSaving}"
                    IsVisible="{Binding IsSaving}"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>