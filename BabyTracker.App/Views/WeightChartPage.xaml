<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:BabyTracker.App.Localization"
             xmlns:microcharts="clr-namespace:Microcharts.Maui;assembly=Microcharts.Maui"
             x:Class="BabyTracker.App.Views.WeightChartPage"
             Title="{loc:Translate Key=Weight_Title}">
    <VerticalStackLayout Padding="15"
            Spacing="15">
        <HorizontalStackLayout Spacing="8"
                HorizontalOptions="Center">
            <Button Text="{loc:Translate Key=Statistics_RangeWeek}"
                    Command="{Binding SelectWeekCommand}"/>
            <Button Text="{loc:Translate Key=Statistics_RangeMonth}"
                    Command="{Binding SelectMonthCommand}"/>
            <Button Text="{loc:Translate Key=Statistics_RangeAll}"
                    Command="{Binding SelectAllCommand}"/>
        </HorizontalStackLayout>

        <microcharts:ChartView Chart="{Binding Chart}"
                HeightRequest="280"
                IsVisible="{Binding HasData}"/>
        <Label Text="{loc:Translate Key=Statistics_NoData}"
                IsVisible="{Binding NoData}"
                HorizontalTextAlignment="Center"/>
    </VerticalStackLayout>
</ContentPage>